{
  "name": "kova-project-website",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "screens:sync": "node scripts/sync-presentation.mjs && node qa/sync-public-copy.mjs",
    "build": "node scripts/assemble-locales.mjs && node scripts/build-site.mjs",
    "preview": "node scripts/preview.mjs",
    "preview:workspace": "node scripts/preview.mjs --source",
    "test": "node qa/run-checks.mjs",
    "test:browser": "node qa/public-site-matrix.mjs",
    "test:navigation": "node qa/navigation-browser.mjs",
    "test:languages": "node qa/check-language-detection.mjs",
    "test:analytics": "node qa/analytics-browser.mjs",
    "test:seo": "node qa/seo-check.mjs",
    "check:release": "node qa/release-check.mjs",
    "build:public": "node scripts/assemble-locales.mjs && node scripts/build-site.mjs --release",
    "test:audit": "node qa/prelaunch-check.mjs",
    "test:audit:browser": "node qa/audit-browser.mjs",
    "test:performance": "node qa/performance-audit.mjs after",
    "verify:deployment": "node scripts/verify-deployment.mjs"
  }
}
